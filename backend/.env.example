# Backend configuration (copy to .env or set in your host's dashboard).

# Comma-separated list of allowed CORS origins. Only needed when the frontend
# is served from a DIFFERENT origin than the API (split hosting). In the
# single-image Hugging Face deploy the frontend is same-origin, so this can be
# left unset.
# CORS_ORIGINS=https://your-frontend.example.com

# Path to the SQLite telemetry database. Defaults to ./docuask.db locally and
# /tmp/docuask.db in the container image. Point at persistent storage
# (e.g. /data/docuask.db) to keep interactions across restarts.
# DOCUASK_DB=/data/docuask.db

# LLM answer generation via any OpenAI-compatible free API. When LLM_API_KEY is
# set, /ask writes a grounded answer from the retrieved passages; when unset,
# DocuAsk falls back to the extractive best-sentence answer (no key, no cost,
# still shows the source passage).
#
# Default provider is Groq (free, no credit card): get a key at
# https://console.groq.com/keys
# LLM_API_KEY=gsk_...
#
# Override to use a different free provider:
#   Groq (default):  LLM_BASE_URL=https://api.groq.com/openai/v1
#                    LLM_MODEL=llama-3.3-70b-versatile
#   Google Gemini:   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                    LLM_MODEL=gemini-2.0-flash
#   OpenRouter:      LLM_BASE_URL=https://openrouter.ai/api/v1
#                    LLM_MODEL=<a free model id>
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
